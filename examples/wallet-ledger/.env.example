# HyperSync API token: https://app.envio.dev/api-tokens
ENVIO_API_TOKEN=
# ClickHouse HTTP endpoint (credentials in the URL) and database name
CLICKHOUSE_URL=http://default:@localhost:8123
CLICKHOUSE_DATABASE=wallet_ledger
# Optional JSON-RPC URLs, enable context.client (token metadata reads)
BASE_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
# Esplora-compatible API for Bitcoin
ESPLORA_URL=https://mempool.space/api
# Start blocks per chain (history before this is never indexed)
BASE_START_BLOCK=30000000
POLYGON_START_BLOCK=70000000
ARBITRUM_START_BLOCK=350000000
BITCOIN_START_BLOCK=800000
# Set to 1 to price every movement in USD through DefiLlama (cached in ClickHouse)
LEDGER_PRICES=0
# OpenTelemetry logs endpoint for evlog (metrics/traces: see `yail/otel`)
OTEL_EXPORTER_OTLP_ENDPOINT=
# Status/admin API port
PORT=42069
